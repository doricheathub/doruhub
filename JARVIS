-- 플레이어 목록 버튼 리프레시 함수
local function refreshPlayerList()
    -- 기존 버튼들 제거
    for _, child in pairs(scrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    -- 현재 서버의 모든 플레이어 순회
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -10, 0, 30)
            btn.BackgroundColor3 = whitelist[player.Name] and Color3.fromRGB(150, 50, 50) or Color3.fromRGB(50, 150, 50)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Text = player.DisplayName .. " (@" .. player.Name .. ")"
            btn.TextSize = 12
            btn.Font = Enum.Font.SourceSans
            btn.Parent = scrollingFrame

            -- 버튼 클릭 시 화이트리스트 토글
            btn.MouseButton1Click:Connect(function()
                if whitelist[player.Name] then
                    whitelist[player.Name] = nil
                    btn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
                    notify("예외 해제", player.Name .. "님이 에임 대상에 포함됩니다.")
                else
                    whitelist[player.Name] = true
                    btn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
                    notify("예외 등록", player.Name .. "님이 에임 대상에서 제외됩니다.")
                end
            end)
        end
    end
end

-- 플레이어가 나갔거나 들어올 때 리스트 갱신
Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(refreshPlayerList)

-- ==========================================
-- 타겟 탐색 및 화이트리스트 적용
-- ==========================================
local function getClosestPlayerHead()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then
        return nil
    end

    local myPos = myChar.HumanoidRootPart.Position
    local closestHead = nil
    local shortestDist = MAX_DISTANCE

    for _, player in pairs(Players:GetPlayers()) do
        -- 예외 목록(whitelist)에 있는 플레이어는 건너뜀
        if player ~= LocalPlayer and not whitelist[player.Name] and player.Character then
            local char = player.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local head = char:FindFirstChild("Head")

            if hum and hum.Health > 0 and head then
                local dist = (head.Position - myPos).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestHead = head
                end
            end
        end
    end

    return closestHead
end

-- ==========================================
-- 키 입력 이벤트 처리
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    -- 0번 키: Silent Aim ON/OFF
    if input.KeyCode == TOGGLE_KEY then
        isEnabled = not isEnabled
        if isEnabled then
            notify("Silent Aim", "판정 고정 기능 [ ON ]")
        else
            notify("Silent Aim", "판정 고정 기능 [ OFF ]")
        end
        
    -- 9번 키: 예외 관리창 표시/숨기기
    elseif input.KeyCode == MENU_KEY then
        mainFrame.Visible = not mainFrame.Visible
        if mainFrame.Visible then
            refreshPlayerList()
            notify("플레이어 목록", "예외 설정창이 열렸습니다.")
        end
    end
end)

-- ==========================================
-- Metatable Hooking (Mouse.Hit / Target 변조)
-- ==========================================
local rawMetatable = getrawmetatable and getrawmetatable(game) or setmetatable({}, {__index = game})
if setreadonly then setreadonly(rawMetatable, false) end

local oldIndex = rawMetatable.__index

rawMetatable.__index = newcclosure(function(self, index)
    if isEnabled and self == Mouse then
        local targetHead = getClosestPlayerHead()
        if targetHead then
            if index == "Hit" then
                return targetHead.CFrame
            elseif index == "Target" then
                return targetHead
            end
        end
    end
    return oldIndex(self, index)
end)

if setreadonly then setreadonly(rawMetatable, true) end
